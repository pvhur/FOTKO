# ── 서버 ──────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── 보안 ──────────────────────────────────────
# 반드시 32자 이상의 무작위 문자열로 설정 (필수)
SESSION_SECRET=your-super-long-random-secret-key-here

# ── 데이터베이스 ──────────────────────────────
# SQLite 파일 경로 (기본: ./data/kickoff.db)
# DATABASE_PATH=./data/kickoff.db

# ── CORS ──────────────────────────────────────
# 호스팅 도메인으로 변경 (예: https://kickoff.example.com)
CORS_ORIGINS=https://your-domain.com

# ── Google OAuth ──────────────────────────────
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보
# 승인된 리디렉션 URI: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback
